---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs')).sort((a, b) => a.data.order - b.data.order);
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

const brandValues = [
  'Innovation',
  'Youth Empowerment',
  'Sustainability',
  'Global Impact',
  'Human-Centered Design',
  'Leadership Development',
];

const journey = [
  { step: 'Think', detail: 'Start from a real African problem.' },
  { step: 'Research', detail: 'Generate and analyse evidence.' },
  { step: 'Design', detail: 'Develop a human-centered solution.' },
  { step: 'Build', detail: 'Prototype, pilot, and test.' },
  { step: 'Influence', detail: 'Shape policy and funding.' },
  { step: 'Scale', detail: 'Grow what works.' },
];
---

<Layout
  title="About"
  description="AfriYouth Innovation Labs is a research, innovation and policy consulting firm that identifies, nurtures, and advances promising ideas from Africa's young innovators to address the SDGs."
>
  <section class="relative overflow-hidden bg-purple-900 py-16 text-white sm:py-20">
    <div
      class="pointer-events-none absolute -right-20 -top-20 h-[380px] w-[380px] rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(circle, #c723df, transparent 70%)"
      aria-hidden="true"
    ></div>
    <div class="reveal relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="font-display text-sm font-semibold uppercase tracking-widest text-pink-500">
        About AfriYouth
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-tight sm:text-5xl">
        Who we are, and what we stand for
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
        By 2030, Africa will have the largest workforce in the world. We exist to give youth the
        ability and capacity to solve African problems, empowering their future independence and
        self-reliance.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="reveal mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-lg leading-relaxed text-ink-soft">
        <strong class="text-ink">AfriYouth Innovation Labs</strong> is a research, innovation and
        policy consulting firm that identifies, nurtures, and advances promising ideas from Africa's
        young innovators to address the Sustainable Development Goals (SDGs). Through human-centered
        design, applied research, and innovation, we transform community-driven ideas into practical
        and scalable solutions that contribute to the socio-economic transformation of Africa and
        beyond.
      </p>

      <div class="mt-14 grid gap-10 sm:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-semibold text-ink">Our Mission</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">
            To empower Africa's youth to generate evidence, shape policy, and develop innovative
            solutions to Africa's most pressing socio-economic challenges through research,
            human-centered design, and entrepreneurship.
          </p>
        </div>
        <div>
          <h2 class="font-display text-2xl font-semibold text-ink">Our Vision</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">
            To build an Africa where empowered young people use evidence, innovation, and
            entrepreneurship to solve complex challenges, shape policies, and drive inclusive and
            sustainable socio-economic transformation by 2050.
          </p>
        </div>
      </div>

      <div class="mt-16 rounded-2xl bg-surface p-8 sm:p-10">
        <h2 class="font-display text-2xl font-semibold text-ink">More than one thing</h2>
        <p class="mt-4 leading-relaxed text-ink-soft">
          AfriYouth connects research, policy, human-centered design, entrepreneurship, and
          foresight, rather than operating solely as a conventional youth organization, incubator,
          think tank, or training organization.
        </p>
      </div>

      <div class="mt-10">
        <h2 class="font-display text-2xl font-semibold text-ink">Why this matters now</h2>
        <p class="mt-4 leading-relaxed text-ink-soft">
          By 2030, Africa will have the largest workforce in the world. That scale is only an
          advantage if young people have the evidence, skills, and platforms to act on it.
          Disconnected research, incubation, and training programmes leave good ideas stranded
          between a report and a solution. AfriYouth exists to close that gap, so community-driven
          ideas become practical, scalable responses to Africa's most pressing socio-economic
          challenges.
        </p>
      </div>
    </div>
  </section>

  <section class="gradient-surface py-16 text-white sm:py-20" aria-labelledby="journey-heading">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 id="journey-heading" class="reveal font-display text-3xl font-bold sm:text-4xl">
        How we think
      </h2>
      <p class="reveal mt-3 max-w-2xl text-white/85">
        Our philosophy, from a community problem to lasting impact.
      </p>
      <ol class="reveal-stagger mt-10 grid gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {journey.map((item, i) => (
          <li class="rounded-xl bg-white/10 p-4 transition-transform hover:-translate-y-1">
            <span class="font-display text-xs font-semibold text-white/60">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="mt-1 font-display text-base font-semibold">{item.step}</p>
            <p class="mt-1 text-xs leading-relaxed text-white/80">{item.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-surface py-16 sm:py-20" aria-labelledby="values-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="values-heading" class="reveal font-display text-3xl font-bold text-ink sm:text-4xl">
        What we value
      </h2>
      <ul class="reveal-stagger mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {brandValues.map((value) => (
          <li class="flex items-center gap-3 rounded-xl border border-purple-900/10 bg-white px-5 py-4 transition-colors hover:border-blue-600">
            <Icon name="check-circle" class="h-5 w-5 shrink-0 text-blue-600" />
            <span class="font-medium text-ink">{value}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20" aria-labelledby="labs-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="labs-heading" class="reveal font-display text-3xl font-bold text-ink sm:text-4xl">
        Our labs
      </h2>
      <p class="reveal mt-3 max-w-2xl text-ink-soft">
        Six labs, brought together to serve young people, organizations, and partners.
      </p>

      <ul class="reveal-stagger mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {labs.map((lab) => (
          <li class="rounded-2xl border border-purple-900/10 p-6 transition-all hover:-translate-y-1 hover:border-blue-600 hover:shadow-md">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-surface text-blue-600">
              <Icon name={lab.data.icon} class="h-5 w-5" />
            </div>
            <h3 class="mt-4 font-display text-lg font-semibold text-ink">{lab.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{lab.data.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {team.length > 0 && (
    <section class="bg-surface py-16 sm:py-20" aria-labelledby="team-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 id="team-heading" class="font-display text-3xl font-bold text-ink sm:text-4xl">
          Our team
        </h2>
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {team.map((member) => (
            <li class="text-center">
              <div class="mx-auto h-24 w-24 overflow-hidden rounded-full bg-purple-900/10">
                {member.data.photo && (
                  <img src={member.data.photo} alt="" class="h-full w-full object-cover" />
                )}
              </div>
              <h3 class="mt-4 font-display text-base font-semibold text-ink">{member.data.name}</h3>
              <p class="text-sm text-ink-soft">{member.data.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="bg-purple-900 py-16 text-center text-white sm:py-20">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Want to work with us?</h2>
      <p class="mt-4 text-white/75">
        Whether you're exploring an opportunity or a collaboration, we'd like to hear from you.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/contact"
          class="rounded-full bg-blue-600 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/20"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>
