---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs')).sort((a, b) => a.data.order - b.data.order);
const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);

const audiences = [
  'African youth and emerging leaders',
  'Development organizations and NGOs',
  'Public institutions and policymakers',
  'Academic and research institutions',
  'Private sector and entrepreneurship ecosystems',
];
---

<Layout
  title="Partner With Us"
  description="Explore collaboration with AfriYouth Innovation Labs: our areas of work, current programs, target audiences, and how to start a conversation."
>
  <section class="bg-purple-900 py-16 text-white sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="font-display text-sm font-semibold uppercase tracking-widest text-pink-500">
        For Partners &amp; Institutions
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-tight sm:text-5xl">
        Let's shape Africa's future together
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">
        AfriYouth collaborates with development organizations, public institutions, and other
        partners to connect research, policy, innovation, and entrepreneurship for lasting impact.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20" aria-labelledby="areas-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="areas-heading" class="font-display text-3xl font-bold text-purple-900 sm:text-4xl">
        Our labs
      </h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {labs.map((lab) => (
          <li>
            <a
              href={`/services#${lab.id}`}
              class="group block rounded-xl border border-purple-900/10 p-5 transition-colors hover:border-blue-600"
            >
              <Icon name={lab.data.icon} class="h-5 w-5 text-blue-600" />
              <h3 class="mt-3 font-display text-base font-semibold text-purple-900">
                {lab.data.title}
              </h3>
              <span class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-blue-600 opacity-0 transition-opacity group-hover:opacity-100">
                View details
                <Icon name="arrow-right" class="h-3 w-3" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-surface py-16 sm:py-20" aria-labelledby="audiences-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2
            id="audiences-heading"
            class="font-display text-3xl font-bold text-purple-900 sm:text-4xl"
          >
            Who we work with
          </h2>
          <ul class="mt-6 space-y-3">
            {audiences.map((audience) => (
              <li class="flex items-start gap-3 text-ink-soft">
                <Icon name="check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-blue-700" />
                {audience}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="font-display text-3xl font-bold text-purple-900 sm:text-4xl">
            Current programs
          </h2>
          <p class="mt-3 text-ink-soft">
            Programs partners can support, co-create, or extend their reach through.
          </p>
          <ul class="mt-6 space-y-4">
            {programs.map((program) => (
              <li class="rounded-xl border border-purple-900/10 bg-white p-5">
                <h3 class="font-display text-base font-semibold text-purple-900">
                  {program.data.title}
                </h3>
                <p class="mt-1 line-clamp-2 text-sm text-ink-soft">{program.data.summary}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-purple-900 py-16 text-white sm:py-20">
    <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Start a conversation</h2>
      <p class="mt-4 text-white/70">
        Tell us about your organization and what collaboration could look like. We'll respond to
        discuss next steps.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/contact"
          class="rounded-full bg-blue-600 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
        >
          Contact AfriYouth
        </a>
      </div>
    </div>
  </section>
</Layout>
