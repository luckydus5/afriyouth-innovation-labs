---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="flex min-h-[60vh] items-center justify-center bg-white px-4 py-20 text-center">
    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-widest text-blue-700">404</p>
      <h1 class="mt-3 font-display text-3xl font-bold text-purple-900 sm:text-4xl">
        We couldn't find that page
      </h1>
      <p class="mt-4 text-ink-soft">
        The page you're looking for may have moved or no longer exists.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center justify-center rounded-full bg-purple-900 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/20"
      >
        Back to Home
      </a>
    </div>
  </section>
</Layout>
