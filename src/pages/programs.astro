---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const programs = (await getCollection('programs')).sort((a, b) => a.data.order - b.data.order);

const statusStyles: Record<string, string> = {
  open: 'bg-blue-600/10 text-blue-700',
  upcoming: 'bg-purple-900/10 text-purple-900',
  closed: 'bg-ink-soft/10 text-ink-soft',
};
---

<Layout
  title="Programs"
  description="Explore AfriYouth Innovation Labs programs and opportunities for young people across Africa. Check eligibility and take the next step."
>
  <section class="relative overflow-hidden bg-purple-900 py-16 text-white sm:py-20">
    <div
      class="pointer-events-none absolute -right-20 -top-20 h-[380px] w-[380px] rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(circle, #c723df, transparent 70%)"
      aria-hidden="true"
    ></div>
    <div class="reveal relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="font-display text-sm font-semibold uppercase tracking-widest text-pink-500">
        For Young People
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-tight sm:text-5xl">
        Find your next opportunity
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">
        AfriYouth programs help young people build skills, generate evidence, and turn ideas into
        action. Browse what's available and see if you're eligible.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20" aria-labelledby="programs-heading">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 id="programs-heading" class="sr-only">
        All programs
      </h2>

      <div class="reveal-stagger space-y-6">
        {programs.map((program) => (
          <article
            id={program.id}
            class="scroll-mt-24 rounded-2xl border border-purple-900/10 bg-white p-7 transition-all hover:border-blue-600 hover:shadow-md sm:p-8"
          >
            <div class="flex flex-wrap items-center gap-3">
              <span
                class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold capitalize ${statusStyles[program.data.status]}`}
              >
                {program.data.status}
              </span>
            </div>

            <h3 class="mt-4 font-display text-2xl font-semibold text-purple-900">
              {program.data.title}
            </h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{program.data.summary}</p>

            {program.data.eligibility.length > 0 && (
              <div class="mt-6">
                <h4 class="font-display text-sm font-semibold uppercase tracking-wide text-purple-900">
                  Eligibility
                </h4>
                <ul class="mt-3 space-y-2">
                  {program.data.eligibility.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-ink-soft">
                      <Icon name="check-circle" class="mt-0.5 h-4 w-4 shrink-0 text-blue-700" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="mt-7">
              {program.data.status === 'open' && program.data.applyUrl ? (
                <a
                  href={program.data.applyUrl}
                  class="inline-flex items-center gap-2 rounded-full bg-purple-900 px-6 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/20"
                >
                  Apply Now
                  <Icon name="arrow-right" class="h-4 w-4" />
                </a>
              ) : (
                <a
                  href="/contact"
                  class="inline-flex items-center gap-2 rounded-full border border-purple-900 px-6 py-3 text-sm font-semibold text-purple-900 transition-colors hover:bg-surface"
                >
                  Register Interest
                  <Icon name="arrow-right" class="h-4 w-4" />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 text-center sm:py-20">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-bold text-purple-900 sm:text-4xl">
        Not sure which program fits?
      </h2>
      <p class="mt-4 text-ink-soft">Reach out and we'll help point you in the right direction.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/contact"
          class="rounded-full bg-purple-900 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/20"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>
