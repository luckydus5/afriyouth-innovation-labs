---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const programs = await getCollection('programs');
  return programs.map((program) => ({
    params: { slug: program.id },
    props: { program },
  }));
}

const { program } = Astro.props;
const { title, summary, status } = program.data;
---

<Layout
  title={`Register interest: ${title}`}
  description={`Register your interest in AfriYouth's ${title} programme.`}
>
  <section class="relative overflow-hidden bg-purple-900 py-16 text-white sm:py-20">
    <div
      class="pointer-events-none absolute -right-20 -top-20 h-[380px] w-[380px] rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(circle, #0301ff, transparent 70%)"
      data-parallax="0.12"
      aria-hidden="true"
    ></div>
    <div class="reveal relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <a
        href={`/programs#${program.id}`}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-pink-500 hover:text-pink-400"
      >
        <Icon name="arrow-left" class="h-4 w-4" />
        Back to {title}
      </a>
      <p class="mt-5 font-display text-sm font-semibold uppercase tracking-widest text-pink-500">
        Register Interest
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-tight sm:text-5xl">{title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">{summary}</p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="reveal mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      {status === 'closed' ? (
        <div class="rounded-2xl border border-purple-900/10 bg-surface p-8 text-center">
          <h2 class="font-display text-xl font-semibold text-purple-900">
            This programme is currently closed
          </h2>
          <p class="mt-3 text-ink-soft">
            We're not accepting new registrations for {title} right now. Contact us to ask about
            future rounds.
          </p>
          <a
            href="/contact"
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-purple-900 px-6 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-blue-700"
          >
            Contact Us
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
      ) : (
        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
          <input type="hidden" name="access_key" value="be537b15-e5df-4643-a8cb-8443e9ba1d8e" />
          <input type="hidden" name="subject" value={`Programme interest: ${title}`} />
          <input type="hidden" name="programme" value={title} />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none" />

          <div class="rounded-xl bg-surface px-4 py-3 text-sm text-ink-soft">
            Registering interest in <strong class="text-ink">{title}</strong>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium text-purple-900">
                Full name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="mt-1.5 w-full rounded-lg border border-purple-900/20 px-4 py-2.5 text-sm text-ink transition-colors focus:border-blue-700 focus:outline-none"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-purple-900">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="mt-1.5 w-full rounded-lg border border-purple-900/20 px-4 py-2.5 text-sm text-ink transition-colors focus:border-blue-700 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-purple-900">
              Phone number
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="mt-1.5 w-full rounded-lg border border-purple-900/20 px-4 py-2.5 text-sm text-ink transition-colors focus:border-blue-700 focus:outline-none"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-purple-900">
              Why are you interested in this programme?
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="mt-1.5 w-full rounded-lg border border-purple-900/20 px-4 py-2.5 text-sm text-ink transition-colors focus:border-blue-700 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="rounded-full bg-purple-900 px-7 py-3.5 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/20"
          >
            Submit Registration
          </button>
        </form>
      )}
    </div>
  </section>
</Layout>
