---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'w-6 h-6' } = Astro.props;

const icons = import.meta.glob('../../node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
}) as Record<string, () => Promise<string>>;

const iconKey = `../../node_modules/lucide-static/icons/${name}.svg`;
const loader = icons[iconKey];

if (!loader) {
  throw new Error(`Icon "${name}" not found in lucide-static`);
}

const rawSvg = await loader();

// Lucide ships each icon with its own class and intrinsic width/height, spread
// over several lines. Drop the dimensions so the utility classes are the only
// size authority, then merge our classes into the existing class attribute.
const svg = rawSvg
  .replace(/\s+(?:width|height)="\d+"/g, '')
  .replace(
    /class="([^"]*)"/,
    (_m, existing) => `class="${existing} ${className}" aria-hidden="true"`,
  );
---

<Fragment set:html={svg} />
