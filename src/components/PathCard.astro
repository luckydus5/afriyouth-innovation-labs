---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  title: string;
  description: string;
  href: string;
  ctaLabel: string;
}

const { icon, title, description, href, ctaLabel } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-2xl border border-purple-900/10 bg-white p-6 transition-all hover:border-blue-600 hover:shadow-lg sm:p-8"
>
  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-surface text-blue-600 transition-colors group-hover:bg-blue-600 group-hover:text-white">
    <Icon name={icon} class="h-6 w-6" />
  </div>
  <h3 class="mt-5 font-display text-xl font-semibold text-ink">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{description}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600">
    {ctaLabel}
    <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </span>
</a>
